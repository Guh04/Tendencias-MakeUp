{
  "name": "@tendencias/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Tendencias MakeUp - PDV e Administracao (dois programas)",
  "author": "Tendencias MakeUp",
  "main": "main.js",
  "scripts": {
    "icon": "node scripts/make-icon.js",
    "start": "electron .",
    "start:admin": "cross-env APP_TARGET=admin electron .",
    "dist:pdv": "cross-env APP_TARGET=pdv electron-builder --config builder.config.js --win --publish never",
    "dist:admin": "cross-env APP_TARGET=admin electron-builder --config builder.config.js --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0"
  }
}
